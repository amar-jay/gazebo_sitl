<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="farm">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="farm_animals">
      <static>1</static>
      <link name="link">
			<!-- farm house -->
	      <visual name="farm_house_visual">
        	<pose degrees="true">-8 0 0 90 0 180</pose>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/farm_house.obj</uri>
	          </mesh>
	        </geometry>
				</visual>
	      <collision name="farm_house_collision">
        	<pose degrees="true">-8 0 0 90 0 0</pose>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/farm_house.obj</uri>
	          </mesh>
	        </geometry>
				</collision>

				<!-- fencing -->
	      <visual name="fence_left_visual">
        	<pose degrees="true">0 8 0 90 0 0</pose>
	        <cast_shadows>true</cast_shadows>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
	        <material>
	          <pbr>
	            <metal>
	              <albedo>1.0 1.0 1.0 1.0</albedo>          <!-- Base color: white metal -->
	              <metalness>1.0</metalness>                <!-- Fully metallic -->
	              <!-- <roughness>0.3</roughness>                Slightly smooth surface -->
	              <ambient_occlusion>1.0</ambient_occlusion> <!-- Default, no AO map -->
	            </metal>
	          </pbr>
	          <cast_shadows>true</cast_shadows>
	        </material>
				</visual>
	      <collision name="fence_left_collision">
        	<pose degrees="true">0 8 0 90 0 0</pose>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
				</collision>
	      <visual name="fence_right_visual">
        	<pose degrees="true">0 -8 0 90 0 0</pose>
	        <cast_shadows>true</cast_shadows>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
	        <material>
	          <pbr>
	            <metal>
	              <albedo>1.0 1.0 1.0 1.0</albedo>          <!-- Base color: white metal -->
	              <metalness>1.0</metalness>                <!-- Fully metallic -->
	              <!-- <roughness>0.3</roughness>                Slightly smooth surface -->
	              <ambient_occlusion>1.0</ambient_occlusion> <!-- Default, no AO map -->
	            </metal>
	          </pbr>
	          <cast_shadows>true</cast_shadows>
	        </material>
				</visual>
	      <collision name="fence_right_collision">
        	<pose degrees="true">0 -8 0 90 0 0</pose>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
				</collision>
	      <visual name="fence_back_visual">
        	<pose degrees="true">10 0 0 90 0 90</pose>
	        <cast_shadows>true</cast_shadows>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
	        <material>
	          <pbr>
	            <metal>
	              <albedo>1.0 1.0 1.0 1.0</albedo>          <!-- Base color: white metal -->
	              <metalness>1.0</metalness>                <!-- Fully metallic -->
	              <roughness>0.3</roughness>                <!-- Slightly smooth surface -->
	              <ambient_occlusion>1.0</ambient_occlusion> <!-- Default, no AO map -->
	            </metal>
	          </pbr>
	          <cast_shadows>true</cast_shadows>
	        </material>
				</visual>
	      <collision name="fence_back_collision">
        	<pose degrees="true">10 0 0 90 0 90</pose>
	        <geometry>
	          <mesh>
	            <uri>model://farm/meshes/wire_fence.obj</uri>
	          </mesh>
	        </geometry>
				</collision>


